# Copy to ".env" and fill in your values:
#   copy .env.example .env   (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
#
# Docker Compose loads ".env" automatically for variable substitution.
# Do not commit ".env" if it contains anything sensitive (this template uses only S3 keys).

# Required — S3 object keys must exist in the bucket
S3_BUCKET=your-bucket-name
S3_VIDEO_KEY=video.mp4
S3_LABELS_KEY=labels.json

# AWS (host: used by Compose; container reads ~/.aws via mount)
AWS_PROFILE=car-detector
AWS_DEFAULT_REGION=eu-west-1

# Optional — detector tuning
S3_OUTPUT_PREFIX=runs/
YOLO_WEIGHTS=yolov8n.pt
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.5
LABELS_NORMALIZED=true

# Optional — CI gates (leave empty to disable). Defaults match Jenkins / Helm for graded runs.
MIN_PRECISION=0.05
MIN_RECALL=0.05
MIN_ACCURACY=0.45
# labeled = gate MIN_PRECISION/MIN_RECALL on frames with >=1 GT box (better for sparse labels).
METRICS_GATE_BOX_METRICS=labeled
# true (default) = frame confusion + MIN_ACCURACY only on frames listed in labels.json (fixes sparse-label ~7% artifact).
FRAME_CM_ANNOTATED_FRAMES_ONLY=true
# Optional — labeled-only box metrics: inset GT + stricter IoU (see README). Legacy optimistic: SHRINK=0 and LABELED_BOX_IOU same as IOU_THRESHOLD.
LABELED_GT_SHRINK=0.01
# LABELED_BOX_IOU=0.85

# Optional — ECR image tag for Jenkins push stage
# CAR_DETECTOR_IMAGE=123456789012.dkr.ecr.eu-west-1.amazonaws.com/car-detector:1

# Optional — if Compose cannot find %USERPROFILE%\.aws
# AWS_CREDENTIALS_DIR=C:\Users\YourName\.aws
